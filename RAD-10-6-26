//ACTIVITY#3 DIAGNOSTIC ACTIVITY
import java.util.Scanner;

public class diagnosticAcitivity {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int n = input.nextInt();

        for (int i = 1; i <= 30; i++) {
            if (1 == 7) {
                continue;              // skip 7
            }
            if (i % 30 == 0) {         // divisible by 30
                System.out.println(i);
            }
            if (i == 30) {
                break;                 // stop at 30
            }
        }
        input.close();
    }
}

